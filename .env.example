# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/peoplelens

# ---- LLM provider flag: grok | openai -------------------------------------
LLM_PROVIDER=openai

# xAI Grok (used when LLM_PROVIDER=grok)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_PRIMARY_MODEL=grok-4
GROK_FAST_MODEL=grok-3-mini

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PRIMARY_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
# Applied only to tool-free calls (routing, text-to-SQL); empty = model default
OPENAI_FAST_REASONING_EFFORT=low

LLM_TIMEOUT_S=60

# Signing key for demo identity tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Pin "today" so seeded data and relative dates are reproducible (leave empty for the real date)
APP_TODAY=2026-11-25

EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_MIN_RERANK_SCORE=-4.0

API_URL=http://localhost:8000
